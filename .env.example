# ==============================================================
# Prestige Computers Website - Production Environment Variables
# ==============================================================
# When deploying to hosting platforms (e.g., Vercel, VPS, Netlify, Render):
# Set these environment variables in your hosting provider's dashboard
# or in a production .env / .env.production file.
# ==============================================================

# Backend Server Root URL (Used for product media, static uploads, etc.)
# Development: http://localhost:5000
# Production: https://api.yourdomain.com (or your live backend URL)
NEXT_PUBLIC_BACKEND_URL=https://api.yourdomain.com

# Backend REST API v1 Base URL (Used for all data fetching, auth, and orders)
# Development: http://localhost:5000/api/v1
# Production: https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
